# Copie para .env e ajuste os valores. Nunca versione o arquivo .env.

# PostgreSQL
POSTGRES_DB=ribeira
POSTGRES_USER=ribeira
POSTGRES_PASSWORD=troque-esta-senha

# Backend
SPRING_PROFILES_ACTIVE=dev
RIBEIRA_DB_URL=jdbc:postgresql://postgres:5432/ribeira
RIBEIRA_DB_USERNAME=ribeira
RIBEIRA_DB_PASSWORD=troque-esta-senha
# Segredo HMAC (mínimo 32 bytes) usado para assinar tokens de acesso. Gere com: openssl rand -base64 48
RIBEIRA_JWT_SECRET=
# Origens permitidas para CORS (separadas por vírgula)
RIBEIRA_CORS_ALLOWED_ORIGINS=http://localhost:3000
# Cookie de renovação somente via HTTPS (true em produção)
RIBEIRA_COOKIE_SECURE=false
# Cria organização e usuários fictícios de demonstração (somente em ambientes não produtivos)
RIBEIRA_DEMO_DATA_ENABLED=true
# Senha dos usuários fictícios de demonstração
RIBEIRA_DEMO_PASSWORD=

# Frontend
NEXT_PUBLIC_API_BASE_URL=http://localhost:8080
