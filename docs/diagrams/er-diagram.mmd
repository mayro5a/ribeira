  FOOD_BATCHES {
    uuid id PK
    uuid community_id FK
    uuid food_id FK
    uuid storage_location_id FK "opcional"
    uuid donation_item_id FK "ou origin_description"
    numeric initial_quantity "14,3"
    numeric available_quantity "CHECK >= 0"
    varchar unit
    varchar expiration_status "KNOWN | NOT_APPLICABLE | UNKNOWN"
    date expiration_date "obrigatória se KNOWN"
    varchar status "AVAILABLE | BLOCKED | DEPLETED"
    bigint version
  }
  STOCK_MOVEMENTS {
    uuid id PK
    uuid batch_id FK
    varchar type "ENTRY | DISTRIBUTION | LOSS | ADJUSTMENT"
    numeric quantity_delta "sinal conforme o tipo"
    numeric balance_after
    varchar source_type
    uuid source_id
    text justification "obrigatória em ADJUSTMENT"
    uuid performed_by FK
    timestamptz occurred_at
  }
  SYNC_OPERATIONS {
    uuid operation_id PK "idempotência"
    uuid device_id FK
    varchar operation_type
    jsonb payload
    char payload_hash "SHA-256"
    varchar status "APPLIED | REJECTED | CONFLICT | DISCARDED"
    bigint server_seq
  }
  CHANGE_LOG {
    uuid organization_id PK
    bigint seq PK
    uuid community_id
    varchar entity_type
    uuid entity_id
  }
